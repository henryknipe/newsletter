# Quantum Mottle - {{ issue.month_name }} {{ issue.year }}
# Covers what's happened since the last issue. Past issues in examples/ show the format.
#
# Text fields accept light markdown: **bold**, *italic*, [link](https://...),
# blank line = new paragraph, "- item" = bullet, "→ item" = arrow line.
# Any section can take `body_file: something.md` instead of `body:`.
# Delete a section (or leave its body empty) to leave it out of the email.

# subject: "Quantum Mottle - {{ issue.month_name }} {{ issue.year }}"   # default from config.yaml
preheader: ""          # inbox preview text, optional

editor_in_chief:
  body_file: editor_in_chief.md
  signoff: "-H"

dashboard:
  # The screenshot Henry uploads, saved into the issue folder. Or image_url: https://...
  image: dashboard.png

# Two per row (an odd last one goes full width). icon: a name from config.yaml
# `icons:` (evidence, mcq, mri, add, clown, search, muscle...), a URL, or a file
# in the issue folder (e.g. a PNG from magnific.com/icons).
